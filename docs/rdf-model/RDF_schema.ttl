om:CreatePackage rdf:type owl:Class ;
                 rdfs:subClassOf ocel:Event .


###  https://graphbench.org/order-management#Customer
om:Customer rdf:type owl:Class ;
            rdfs:subClassOf ocel:Object .


###  https://graphbench.org/order-management#Employee
om:Employee rdf:type owl:Class ;
            rdfs:subClassOf ocel:Object .


###  https://graphbench.org/order-management#FailedDelivery
om:FailedDelivery rdf:type owl:Class ;
                  rdfs:subClassOf ocel:Event .


###  https://graphbench.org/order-management#Item
om:Item rdf:type owl:Class ;
        rdfs:subClassOf ocel:Object .


###  https://graphbench.org/order-management#ItemOutOfStock
om:ItemOutOfStock rdf:type owl:Class ;
                  rdfs:subClassOf ocel:Event .


###  https://graphbench.org/order-management#Order
om:Order rdf:type owl:Class ;
         rdfs:subClassOf ocel:Object .


###  https://graphbench.org/order-management#Package
om:Package rdf:type owl:Class ;
