@prefix : <https://graphbench.org/order-management#> .
@prefix om: <https://graphbench.org/order-management#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ocel: <https://graphbench.org/ocel#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://graphbench.org/order-management> .

<https://graphbench.org/order-management> rdf:type owl:Ontology ;
                                           owl:versionIRI <https://graphbench.org/order-management/1.0.0> .

#################################################################
#    Object Properties
#################################################################

###  https://graphbench.org/ocel#hasAttributeValue
ocel:hasAttributeValue rdf:type owl:ObjectProperty ;
                       rdfs:domain ocel:Object ;
                       rdfs:range ocel:AttributeValue .


###  https://graphbench.org/ocel#hasObject
ocel:hasObject rdf:type owl:ObjectProperty ;
               rdfs:domain ocel:Event ;
               rdfs:range ocel:Object .


###  https://graphbench.org/ocel#relatedTo
ocel:relatedTo rdf:type owl:ObjectProperty ;
               rdfs:domain ocel:Object ;
               rdfs:range ocel:Object .


###  https://graphbench.org/order-management#belongsToOrder
om:belongsToOrder rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf ocel:relatedTo ;
                  owl:inverseOf om:comprises ;
                  rdfs:domain om:Item ;
                  rdfs:range om:Order .


###  https://graphbench.org/order-management#comprises
om:comprises rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf ocel:relatedTo ;
             rdfs:domain om:Order ;
             rdfs:range om:Item .


###  https://graphbench.org/order-management#contains
om:contains rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf ocel:relatedTo ;
            owl:inverseOf om:packedInto ;
            rdfs:domain om:Package ;
            rdfs:range om:Item .


###  https://graphbench.org/order-management#creates
om:creates rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf ocel:hasObject ;
           rdfs:domain ocel:Event ;
           rdfs:range om:Package .


###  https://graphbench.org/order-management#customer
om:customer rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf ocel:hasObject ;
            rdfs:domain ocel:Event ;
            rdfs:range om:Customer .


###  https://graphbench.org/order-management#employee
om:employee rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf ocel:hasObject ;
            rdfs:domain ocel:Event ;
            rdfs:range om:Employee .


###  https://graphbench.org/order-management#forwardedBy
om:forwardedBy rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf ocel:relatedTo ;
               rdfs:domain om:Package ;
               rdfs:range om:Employee .


###  https://graphbench.org/order-management#forwarder
om:forwarder rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf ocel:hasObject ;
             rdfs:domain ocel:Event ;
             rdfs:range om:Employee .


###  https://graphbench.org/order-management#isA
om:isA rdf:type owl:ObjectProperty ;
       rdfs:subPropertyOf ocel:relatedTo ;
       rdfs:domain om:Item ;
       rdfs:range om:Product .


###  https://graphbench.org/order-management#item
om:item rdf:type owl:ObjectProperty ;
        rdfs:subPropertyOf ocel:hasObject ;
        rdfs:domain ocel:Event ;
        rdfs:range om:Item .


###  https://graphbench.org/order-management#order
om:order rdf:type owl:ObjectProperty ;
         rdfs:subPropertyOf ocel:hasObject ;
         rdfs:domain ocel:Event ;
         rdfs:range om:Order .


###  https://graphbench.org/order-management#packedBy
om:packedBy rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf ocel:relatedTo ;
            rdfs:domain om:Package ;
            rdfs:range om:Employee .


###  https://graphbench.org/order-management#packedInto
om:packedInto rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf ocel:relatedTo ;
              rdfs:domain om:Item ;
              rdfs:range om:Package .


###  https://graphbench.org/order-management#packer
om:packer rdf:type owl:ObjectProperty ;
          rdfs:subPropertyOf ocel:hasObject ;
          rdfs:domain ocel:Event ;
          rdfs:range om:Employee .


###  https://graphbench.org/order-management#places
om:places rdf:type owl:ObjectProperty ;
          rdfs:subPropertyOf ocel:relatedTo ;
          rdfs:domain om:Customer ;
          rdfs:range om:Order .


###  https://graphbench.org/order-management#primarySalesRep
om:primarySalesRep rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf ocel:relatedTo ;
                   rdfs:domain om:Customer ;
                   rdfs:range om:Employee .


###  https://graphbench.org/order-management#product
om:product rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf ocel:hasObject ;
           rdfs:domain ocel:Event ;
           rdfs:range om:Product .


###  https://graphbench.org/order-management#salesPerson
om:salesPerson rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf ocel:hasObject ;
               rdfs:domain ocel:Event ;
               rdfs:range om:Employee .


###  https://graphbench.org/order-management#secondarySalesRep
om:secondarySalesRep rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf ocel:relatedTo ;
                     rdfs:domain om:Customer ;
                     rdfs:range om:Employee .


###  https://graphbench.org/order-management#shippedBy
om:shippedBy rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf ocel:relatedTo ;
             rdfs:domain om:Package ;
             rdfs:range om:Employee .


###  https://graphbench.org/order-management#shippedPackage
om:shippedPackage rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf ocel:hasObject ;
                  rdfs:domain ocel:Event ;
                  rdfs:range om:Package .


###  https://graphbench.org/order-management#shipper
om:shipper rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf ocel:hasObject ;
           rdfs:domain ocel:Event ;
           rdfs:range om:Employee .


#################################################################
#    Data properties
#################################################################

###  https://graphbench.org/ocel#attributeName
ocel:attributeName rdf:type owl:DatatypeProperty ,
                            owl:FunctionalProperty ;
                   rdfs:domain ocel:AttributeValue ;
                   rdfs:range xsd:string .


###  https://graphbench.org/ocel#time
ocel:time rdf:type owl:DatatypeProperty ,
                   owl:FunctionalProperty ;
          rdfs:domain [ rdf:type owl:Class ;
                        owl:unionOf ( ocel:AttributeValue
                                      ocel:Event
                                    )
                      ] ;
          rdfs:range xsd:dateTime .


###  https://graphbench.org/ocel#value
ocel:value rdf:type owl:DatatypeProperty ,
                    owl:FunctionalProperty ;
           rdfs:domain ocel:AttributeValue ;
           rdfs:range [ rdf:type rdfs:Datatype ;
                        owl:unionOf ( xsd:decimal
                                      xsd:string
                                    )
                      ] .


