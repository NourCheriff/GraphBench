#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( ocel:AttributeValue
                ocel:Event
                ocel:Object
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( om:ConfirmOrder
                om:CreatePackage
                om:FailedDelivery
                om:ItemOutOfStock
                om:PackageDelivered
                om:PayOrder
                om:PaymentReminder
                om:PickItem
                om:PlaceOrder
                om:ReorderItem
                om:SendPackage
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( om:Customer
                om:Employee
                om:Item
                om:Order
                om:Package
                om:Product
              )
] .


