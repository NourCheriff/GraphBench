# Q3 - Customer orders
# Which are the orders placed given a specific customer
# $customer is replaced with the IRI of the ID by the benchmark

PREFIX ocel: <https://graphbench.org/ocel#>
PREFIX om: <https://graphbench.org/order-management#>

SELECT ?order ?date ?price ?items
WHERE {
  VALUES ?customer { $customer }
  ?customer om:places ?order .

  ?order    om:price ?price 	;
            om:comprises ?items	.
    
  ?placement	a 			om:PlaceOrder	;
    			om:order	?order			;
    			ocel:time	?date			.
}
ORDER BY ?date