# Q1 - Order event sequence
# Which are the events involved given a specific order
# $order is replaced with the IRI of the ID by the benchmark

PREFIX ocel: <https://graphbench.org/ocel#>
PREFIX om: <https://graphbench.org/order-management#>

SELECT ?time ?event ?type
WHERE {
  VALUES ?order { $order }
  ?event om:order ?order ;
         a ?type ;
         ocel:time ?time .
  FILTER(STRSTARTS(STR(?type), STR(om:)))
}
ORDER BY ?time